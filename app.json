{
  "expo": {
    "name": "댕로컬",
    "slug": "petmap",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "petmap",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.petmap.daenglocal",
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "NSCameraUsageDescription": "댕로컬이 여행 기록에 사진과 영상을 촬영하기 위해 카메라를 사용합니다.",
        "NSMicrophoneUsageDescription": "댕로컬이 3초 여행 영상을 녹화하기 위해 마이크를 사용합니다."
      }
    },
    "android": {
      "package": "com.petmap.daenglocal",
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#EAF7F0",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#2F8F67",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "@maplibre/maplibre-react-native",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "댕로컬이 지도에서 현재 위치를 표시하기 위해 위치를 사용합니다."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "댕로컬이 여행 기록에 사진과 영상을 촬영하기 위해 카메라를 사용합니다.",
          "microphonePermission": "댕로컬이 3초 여행 영상을 녹화하기 위해 마이크를 사용합니다.",
          "recordAudioAndroid": true,
          "barcodeScannerEnabled": false
        }
      ],
      "expo-asset",
      "expo-image",
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
